<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js{% unless settings.motion_enabled %} no-motion{% endunless %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000080">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}
    {%- assign brand = settings.brand_name | default: shop.name -%}
    <title>{{ brand }}: opening soon</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% render 'meta-tags', brand: brand %}
    {% render 'font-faces' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.replace('no-js','js');</script>
    {{ content_for_header }}
  </head>
  <body class="tpl-password">
    <main id="MainContent" class="main main--pw" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
