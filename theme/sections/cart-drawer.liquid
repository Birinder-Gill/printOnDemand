{%- comment -%}
  Cart drawer, styled as a thermal receipt printed out of a toy-store register: printed header, item lines with
  dotted leaders, quantity keys, totals, the big yellow Check out key and a torn edge. Re-rendered with the
  Section Rendering API (id "cart-drawer") after every cart change.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name | default: shop.name
-%}
<div class="drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" hidden data-cart-drawer>
  <div class="drawer__scrim" data-cart-close></div>
  <div class="drawer__panel">
    <div class="drawer__register" aria-hidden="true">
      <span class="drawer__slot"></span>
    </div>
    <div class="drawer__head">
      <h2 class="drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
      <button class="drawer__close" type="button" data-cart-close>
        {%- render 'icon', name: 'x' -%}<span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
    </div>
    <div class="drawer__body" data-cart-body>
      {%- render 'receipt', brand: brand, compact: true -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Receipt cart drawer",
  "class": "sct-cart-drawer",
  "settings": []
}
{% endschema %}
