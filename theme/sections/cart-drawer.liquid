{%- comment -%}
  Cart drawer: a ruled paper slab that slides in from the right. Re-rendered with the Section Rendering API
  (section id "cart-drawer") after every cart change; global.js swaps [data-cart-body].
{%- endcomment -%}
<div class="qcd" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" hidden data-cart-drawer>
  <div class="qcd__scrim" data-cart-close></div>
  <div class="qcd__panel">
    <div class="qcd__head">
      <h2 class="qcd__title" id="CartDrawerTitle">{{ 'general.cart' | t }} <span class="qcd__n q-num" data-cart-count>{{ cart.item_count }}</span></h2>
      <button class="qcd__close" type="button" data-cart-close data-cart-focus>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>
        <span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" data-cart-status></p>
    <div class="qcd__body" data-cart-body>
      {%- render 'qh-cart', compact: true -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "class": "sct-cart-drawer",
  "settings": []
}
{% endschema %}
