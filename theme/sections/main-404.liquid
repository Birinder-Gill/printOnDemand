{%- comment -%}
  404: a see-through grape handheld game, held sideways. The LCD says GAME OVER and counts down a CONTINUE? screen from 9; the
  A and B buttons are real links (home and search), and the d-pad points to the book.
{%- endcomment -%}
{{ '404.css' | asset_url | stylesheet_tag }}
<script src="{{ '404.js' | asset_url }}" defer></script>
{%- liquid
  assign book_url = routes.all_products_collection_url
  if settings.hero_product != blank
    assign book_url = settings.hero_product.url
  endif
-%}
<section class="nf" aria-labelledby="NfTitle-{{ section.id }}">
  <div class="nf__in">
    <div class="hh">
      <div class="hh__side hh__side--l">
        <a class="hh__pad" href="{{ book_url }}"><span class="visually-hidden">{{ section.settings.pad_label }}</span><i aria-hidden="true"></i></a>
        <span class="hh__grille" aria-hidden="true"></span>
      </div>
      <div class="hh__mid">
        <div class="hh__bezel">
          <div class="hh__lcd" data-nf-lcd>
            <h1 class="hh__title" id="NfTitle-{{ section.id }}"><span class="hh__big">404</span><span>{{ section.settings.line_1 }}</span></h1>
            <p class="hh__line">{{ section.settings.line_2 }}</p>
            <p class="hh__cont" aria-hidden="true">{{ section.settings.continue }} <span class="hh__count" data-nf-count>9</span></p>
            <p class="hh__over" aria-hidden="true">{{ section.settings.game_over }}</p>
          </div>
        </div>
        <p class="hh__brand" aria-hidden="true"><i></i>{{ section.settings.brand }}<small>{{ section.settings.model }}</small></p>
        <div class="hh__ss" aria-hidden="true"><span>Select</span><span>Start</span></div>
      </div>
      <div class="hh__side hh__side--r">
        <div class="hh__ab">
          <a class="hh__btn hh__btn--b" href="{{ routes.search_url }}"><span aria-hidden="true">B</span><small>{{ section.settings.b_label }}</small></a>
          <a class="hh__btn hh__btn--a" href="{{ routes.root_url }}"><span aria-hidden="true">A</span><small>{{ section.settings.a_label }}</small></a>
        </div>
        <span class="hh__grille" aria-hidden="true"></span>
      </div>
    </div>
    <div class="nf__copy">
      <p class="nf__kicker">{{ section.settings.kicker }}</p>
      <p class="nf__text">{{ section.settings.text }}</p>
      <ul class="nf__links" role="list">
        <li><a class="btn" href="{{ book_url }}">{{ section.settings.cta }}</a></li>
        <li><a class="nf__link" href="{{ routes.root_url }}">{{ section.settings.a_label }}</a></li>
        <li><a class="nf__link" href="{{ routes.search_url }}">{{ section.settings.b_label }}</a></li>
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Game over (404)",
  "class": "sct-404",
  "settings": [
    { "type": "text", "id": "line_1", "label": "LCD line 1", "default": "Page not found" },
    { "type": "text", "id": "line_2", "label": "LCD line 2", "default": "This level doesn't exist." },
    { "type": "text", "id": "continue", "label": "Continue prompt", "default": "Continue?" },
    { "type": "text", "id": "game_over", "label": "Game over text", "default": "Game over" },
    { "type": "text", "id": "brand", "label": "Name on the handheld", "default": "Pocket Pal" },
    { "type": "text", "id": "model", "label": "Model", "default": "404 edition" },
    { "type": "text", "id": "pad_label", "label": "D-pad link label", "default": "Go to the book" },
    { "type": "text", "id": "a_label", "label": "A button", "default": "Home" },
    { "type": "text", "id": "b_label", "label": "B button", "default": "Search" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Error 404" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The page you were looking for got taped over. Press A to start over, B to search, or go straight to the book." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Go to the book" }
  ]
}
{% endschema %}
