{%- comment -%}
  Article: one page of the photocopied zine. Ransom-note headline, typed byline on a tape strip, the text in a single
  photocopied column with photos taped in, and a back link scrawled in marker.
{%- endcomment -%}
{{ 'zine.css' | asset_url | stylesheet_tag }}
<article class="zn zn--article" aria-labelledby="ZaTitle-{{ section.id }}">
  <header class="zn__mast">
    <p class="zn__issue"><span><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>{%- if article.author != blank -%} · {{ 'blogs.by' | t: author: article.author }}{%- endif -%}</span></p>
    <h1 class="zn__title zn__title--article" id="ZaTitle-{{ section.id }}" aria-label="{{ article.title | escape }}">{% render 'ransom', text: article.title %}</h1>
  </header>
  <div class="zn__sheet">
    {%- if article.image -%}
      <figure class="zn__hero"><span class="clip__tape" aria-hidden="true"></span>{{ article.image | image_url: width: 1400 | image_tag: alt: article.image.alt, widths: '600,900,1200,1400', sizes: '(min-width: 990px) 760px, 92vw' }}</figure>
    {%- endif -%}
    <div class="zn__body rte">{{ article.content }}</div>
    {%- if article.tags.size > 0 -%}
      <ul class="zn__tags" role="list">{%- for t in article.tags -%}<li>#{{ t }}</li>{%- endfor -%}</ul>
    {%- endif -%}
    <p class="zn__back"><a href="{{ blog.url }}">&larr; {{ 'blogs.back' | t }}</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Zine page (article)",
  "class": "sct-zine",
  "settings": []
}
{% endschema %}
