{%- comment -%}
  Cart page: the checkout counter of a 90s toy store. A neon sign on the slatwall, a beige register with a green
  vacuum-fluorescent total, the receipt printing out onto a confetti Formica counter, the book on one side and a
  manila gift tag (the order note) plus a typed index card on the other.
  The whole block re-renders through the Section Rendering API (data-cart-page + data-section) after each change.
{%- endcomment -%}
{{ 'main-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-cart.js' | asset_url }}" defer></script>
{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign amount = cart.total_price | money_without_currency | remove: ','
  assign ghost = amount | replace: '0', '8' | replace: '1', '8' | replace: '2', '8' | replace: '3', '8' | replace: '4', '8' | replace: '5', '8' | replace: '6', '8' | replace: '7', '8' | replace: '9', '8'
  assign qty = cart.item_count
  if qty < 10
    assign qty_txt = '0' | append: qty
  else
    assign qty_txt = qty
  endif
  assign hero = settings.hero_product
  assign back_url = routes.all_products_collection_url
  if hero != blank
    assign back_url = hero.url
  endif
-%}
<div class="ck{% if cart.item_count == 0 %} ck--empty{% endif %}" data-cart-page data-section="{{ section.id }}">
  <div class="ck__wall">
    <div class="ck__sign">
      <p class="ck__lane" aria-hidden="true"><span class="ck__lane-word">{{ section.settings.lane_label }}</span><span class="ck__lane-n">{{ section.settings.lane_number }}</span></p>
      <h1 class="ck__title"><span class="ck__neon">{{ 'cart.title' | t }}</span></h1>
      {%- if section.settings.sub != blank -%}<p class="ck__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
  </div>

  <div class="ck__counter">
    <div class="ck__stage">
      <div class="ck__left" aria-hidden="true">
        {%- if section.settings.book_image != blank -%}
          <div class="ck__book">
            {{ section.settings.book_image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 1100px) 26vw, 1px', class: 'ck__book-img' }}
            {%- if hero != blank and cart.item_count > 0 -%}
              <span class="ck__gun"><span class="ck__gun-k">Price</span>{{ hero.price | money_without_trailing_zeros }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="ck__mid">
        <div class="reg" aria-hidden="true">
          <div class="reg__pole">
            <div class="reg__vfd">
              <p class="reg__row"><span class="reg__l">{% if cart.item_count > 0 %}TOTAL{% else %}NO!SALE{% endif %}</span><span class="reg__l reg__l--dim">QTY!{{ qty_txt }}</span></p>
              <p class="reg__amt"><span class="reg__ghost">{{ ghost }}</span><span class="reg__val">{{ amount }}</span></p>
            </div>
          </div>
          <div class="reg__neck"></div>
          <div class="reg__body">
            <div class="reg__deck">
              <div class="reg__keys">
                {%- assign keys = '7,8,9,4,5,6,1,2,3,0,00,.' | split: ',' -%}
                {%- for k in keys -%}<span class="reg__key">{{ k }}</span>{%- endfor -%}
              </div>
              <div class="reg__fn">
                <span class="reg__key reg__key--red">Void</span>
                <span class="reg__key reg__key--sun">Qty</span>
                <span class="reg__key reg__key--sky">Sub<br>total</span>
                <span class="reg__key reg__key--total">Total</span>
              </div>
            </div>
            <div class="reg__side">
              <p class="reg__plate"><span>{{ section.settings.register_name }}</span><small>{{ section.settings.register_model }}</small></p>
              <span class="reg__lock"><span></span></span>
              <span class="reg__roll"></span>
            </div>
          </div>
          <div class="reg__drawer"><span class="reg__handle"></span></div>
          <div class="reg__lip"><span class="reg__slot"></span></div>
        </div>

        <div class="ck__receipt">
          {%- render 'receipt', brand: brand, compact: false -%}
        </div>
        {%- if cart.item_count > 0 -%}
          <p class="ck__back"><a href="{{ back_url }}">{%- render 'icon', name: 'arrow-left' -%}<span>{{ section.settings.back_label }}</span></a></p>
        {%- endif -%}
      </div>

      <div class="ck__right">
        {%- if section.settings.show_note and cart.item_count > 0 -%}
          <div class="tag-wrap">
          <svg class="tag__string" viewBox="0 0 150 110" aria-hidden="true"><path d="M8 92c-14-10-12-30 4-34 22-6 30 26 52 10 18-13 22-48 60-66" fill="none" stroke="#e8442f" stroke-width="3.2" stroke-linecap="round"/><path d="M8 92c-14-10-12-30 4-34 22-6 30 26 52 10 18-13 22-48 60-66" fill="none" stroke="#ff8a6e" stroke-width="1" stroke-dasharray="2 4" stroke-linecap="round"/></svg>
          <div class="tag">
            <span class="tag__hole" aria-hidden="true"></span>
            <label class="tag__label" for="CartNote">{{ section.settings.note_label }}</label>
            <textarea class="tag__note" id="CartNote" name="note" form="CartPageForm" rows="4" placeholder="{{ section.settings.note_placeholder | escape }}" data-cart-note>{{ cart.note }}</textarea>
            <p class="tag__saved" data-cart-note-status aria-live="polite"></p>
          </div>
          </div>
        {%- endif -%}
        {%- if section.settings.card_text != blank -%}
          <div class="icard">
            <h2 class="icard__title">{{ section.settings.card_title }}</h2>
            <div class="icard__text rte">{{ section.settings.card_text }}</div>
            {%- if section.settings.card_link_label != blank and section.settings.card_link != blank -%}
              <a class="icard__link" href="{{ section.settings.card_link }}">{{ section.settings.card_link_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
  <div class="ck__edge" aria-hidden="true"></div>
</div>

{% schema %}
{
  "name": "Checkout counter (cart)",
  "class": "sct-main-cart",
  "settings": [
    { "type": "text", "id": "lane_label", "label": "Lane light word", "default": "Lane" },
    { "type": "text", "id": "lane_number", "label": "Lane number", "default": "3" },
    { "type": "text", "id": "sub", "label": "Line under the sign", "default": "Check the receipt, then check out." },
    { "type": "image_picker", "id": "book_image", "label": "Book on the counter (transparent PNG)" },
    { "type": "text", "id": "register_name", "label": "Register name plate", "default": "Sales-Mate" },
    { "type": "text", "id": "register_model", "label": "Register model", "default": "Model 90" },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "Back to the book" },
    { "type": "checkbox", "id": "show_note", "label": "Show order note (gift tag)", "default": true },
    { "type": "text", "id": "note_label", "label": "Order note label", "default": "Order note" },
    { "type": "text", "id": "note_placeholder", "label": "Order note placeholder", "default": "Anything we should know about this order?" },
    { "type": "text", "id": "card_title", "label": "Index card title", "default": "At checkout" },
    { "type": "richtext", "id": "card_text", "label": "Index card text", "default": "<p>Shipping and any taxes are shown before you pay.</p><p>You'll get an email receipt and tracking once it ships.</p>" },
    { "type": "text", "id": "card_link_label", "label": "Index card link label", "default": "Shipping & returns" },
    { "type": "url", "id": "card_link", "label": "Index card link" }
  ]
}
{% endschema %}
