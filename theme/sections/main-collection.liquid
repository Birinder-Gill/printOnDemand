{%- comment -%}
  Collection: a page from a 90s toy catalog. Glossy white page with a colored header band, page numbers in the
  corners, products laid out as catalog listings (item number, price in red, short copy, a button), and a kid's red
  crayon circle around the first item with a note scrawled next to it. The first item is shown as the feature listing.
{%- endcomment -%}
{{ 'main-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign page_no = section.settings.page_number
-%}
<section class="cat" aria-labelledby="CatTitle-{{ section.id }}">
  <div class="cat__page">
    <span class="cat__pno cat__pno--l" aria-hidden="true">{{ page_no }}</span>
    <span class="cat__pno cat__pno--r" aria-hidden="true">{{ page_no | plus: 1 }}</span>
    <header class="cat__band">
      <p class="cat__kicker">{{ section.settings.kicker }}</p>
      <h1 class="cat__title" id="CatTitle-{{ section.id }}">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="cat__desc rte">{{ collection.description }}</div>{%- endif -%}
      <span class="cat__burst" aria-hidden="true">{{ section.settings.burst }}</span>
    </header>

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="cat__grid{% if collection.products.size == 1 %} cat__grid--one{% endif %}" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign v = product.selected_or_first_available_variant
              assign feature = false
              if forloop.first and paginate.current_page == 1
                assign feature = true
              endif
              assign item_no = v.sku | default: product.id
              assign buy_id = 'CatBuy-' | append: product.id
            -%}
            <li class="item{% if feature %} item--feature{% endif %}">
              <a class="item__img" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_media -%}
                  {%- if feature -%}
                    {{ product.featured_media | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 50vw, 92vw', alt: '' }}
                  {%- else -%}
                    {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 30vw, 46vw', alt: '' }}
                  {%- endif -%}
                {%- endif -%}
              </a>
              <div class="item__copy">
                <p class="item__no"><span>{{ section.settings.item_label }}</span> {{ item_no }}</p>
                <h2 class="item__name"><a href="{{ product.url }}">{{ product.title }}</a></h2>
                {%- if feature -%}<p class="item__blurb">{{ product.description | strip_html | truncatewords: 34 }}</p>{%- endif -%}
                <p class="item__price">
                  {%- if product.compare_at_price > product.price -%}<s class="item__was">{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
                  <span class="item__now">{{ product.price | money_without_trailing_zeros }}</span><span class="item__ea">{{ section.settings.each_label }}</span>
                </p>
                {%- if product.has_only_default_variant -%}
                  {%- render 'buy-button', product: product, id: buy_id, label: '' -%}
                {%- else -%}
                  <a class="btn" href="{{ product.url }}">{{ section.settings.choose_label }}</a>
                {%- endif -%}
              </div>
              {%- if feature and section.settings.crayon_note != blank -%}
                <svg class="item__circle" viewBox="0 0 600 420" preserveAspectRatio="none" aria-hidden="true"><defs><filter id="Crayon-{{ section.id }}"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="5"/></filter></defs>
                  <path d="M318 18C170 8 34 60 22 196c-11 128 130 206 290 204 162-2 274-74 268-200C574 70 452 16 300 28 236 34 182 50 150 64" fill="none" stroke="#e3121b" stroke-width="9" stroke-linecap="round" filter="url(#Crayon-{{ section.id }})" opacity=".9"/>
                  <path d="M312 30C188 22 52 72 40 194c-10 118 122 190 274 188" fill="none" stroke="#e3121b" stroke-width="4" stroke-linecap="round" filter="url(#Crayon-{{ section.id }})" opacity=".55"/>
                </svg>
                <p class="item__crayon" aria-hidden="true">{{ section.settings.crayon_note }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}
          <nav class="cat__pages" aria-label="{{ 'general.page' | t: number: paginate.current_page }}">
            {%- if paginate.previous -%}<a class="btn btn--sm btn--white" href="{{ paginate.previous.url }}">{%- render 'icon', name: 'arrow-left' -%}{{ 'general.previous' | t }}</a>{%- endif -%}
            <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a class="btn btn--sm btn--white" href="{{ paginate.next.url }}">{{ 'general.next' | t }}{%- render 'icon', name: 'arrow-right' -%}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="cat__empty"><p>{{ section.settings.empty_text }}</p><a class="btn" href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></div>
      {%- endif -%}
    {%- endpaginate -%}

    {%- if section.settings.index_links != blank -%}
      <nav class="cat__index" aria-label="{{ section.settings.index_label | escape }}">
        <p class="cat__index-k">{{ section.settings.index_label }}</p>
        <ul role="list">
          {%- for link in section.settings.index_links.links -%}
            <li><a href="{{ link.url }}"><span>{{ link.title }}</span><i aria-hidden="true"></i><em>{{ page_no | plus: 2 | plus: forloop.index | times: 3 }}</em></a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Toy catalog (collection)",
  "class": "sct-catalog",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 3, "max": 24, "step": 3, "default": 12 },
    { "type": "number", "id": "page_number", "label": "Catalog page number", "default": 214 },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The 1990s catalog" },
    { "type": "text", "id": "burst", "label": "Starburst", "default": "New this year!" },
    { "type": "text", "id": "item_label", "label": "Item number label", "default": "Item" },
    { "type": "text", "id": "each_label", "label": "After the price", "default": "ea." },
    { "type": "text", "id": "choose_label", "label": "Button for products with options", "default": "Choose options" },
    { "type": "text", "id": "crayon_note", "label": "Crayon note by the first item", "default": "THIS ONE!!" },
    { "type": "text", "id": "empty_text", "label": "Empty collection text", "default": "Nothing on this page yet. Check back soon." },
    { "type": "text", "id": "index_label", "label": "Index heading", "default": "Also in this catalog" },
    { "type": "link_list", "id": "index_links", "label": "Index links" }
  ]
}
{% endschema %}
