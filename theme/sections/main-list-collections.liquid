{%- comment -%}
  All collections: a backlit mall directory. Bronze frame, a floor plan where each collection is a storefront
  (with a red YOU ARE HERE dot by the entrance), and the store list down the side with unit numbers.
{%- endcomment -%}
{{ 'main-list-collections.css' | asset_url | stylesheet_tag }}
{%- assign colors = '#ff2f8e,#38c6f4,#ffd21f,#00a99d,#ff6a1f,#8d5cf0,#b5e61d' | split: ',' -%}
<section class="mall" aria-labelledby="MallTitle-{{ section.id }}">
  <div class="mall__board">
    <header class="mall__head">
      <p class="mall__kicker">{{ section.settings.kicker }}</p>
      <h1 class="mall__title" id="MallTitle-{{ section.id }}">{{ section.settings.heading }}</h1>
    </header>
    <div class="mall__body">
      <div class="mall__map" aria-hidden="true">
        <div class="mall__floor">
          {%- for c in collections -%}
            {%- assign ci = forloop.index0 | modulo: 7 -%}
            <span class="mall__unit" style="--c:{{ colors[ci] }}"><b>{{ forloop.index | plus: 100 }}</b>{{ c.title }}</span>
          {%- endfor -%}
          <span class="mall__unit mall__unit--food"><b>FC</b>{{ section.settings.food_court }}</span>
          <span class="mall__fountain"></span>
          <span class="mall__you"><i></i>{{ section.settings.you_are_here }}</span>
        </div>
      </div>
      <div class="mall__list">
        <p class="mall__listhead"><span>{{ section.settings.list_label }}</span><span>{{ section.settings.unit_label }}</span></p>
        <ul role="list">
          {%- for c in collections -%}
            {%- assign ci = forloop.index0 | modulo: 7 -%}
            <li>
              <a href="{{ c.url }}" style="--c:{{ colors[ci] }}">
                <span class="mall__dot" aria-hidden="true"></span>
                <span class="mall__name">{{ c.title }}<small>{{ c.products_count }} {{ c.products_count | pluralize: 'item', 'items' }}</small></span>
                <span class="mall__no">{{ forloop.index | plus: 100 }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <p class="mall__hours">{{ section.settings.hours }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mall directory (collections)",
  "class": "sct-mall",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Directory" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find a store" },
    { "type": "text", "id": "list_label", "label": "List heading", "default": "Stores" },
    { "type": "text", "id": "unit_label", "label": "Unit column heading", "default": "Unit" },
    { "type": "text", "id": "you_are_here", "label": "You are here", "default": "You are here" },
    { "type": "text", "id": "food_court", "label": "Food court label", "default": "Food court" },
    { "type": "text", "id": "hours", "label": "Line under the list", "default": "Open 24 hours online. No mall walkers required." }
  ]
}
{% endschema %}
