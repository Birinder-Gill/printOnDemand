{%- comment -%}
  Password page: a homemade 1990s web page, under construction. A browser window on a starfield, a striped
  UNDER CONSTRUCTION banner with a flashing beacon, a scrolling marquee, a visitor counter, "best viewed" badges,
  the guestbook (the email signup) and, tucked at the bottom, the webmaster's door (the store password form).
{%- endcomment -%}
{{ 'main-password.css' | asset_url | stylesheet_tag }}
{%- assign brand = settings.brand_name | default: shop.name -%}
<section class="uc" aria-labelledby="UcTitle-{{ section.id }}">
  <div class="uc__win">
    <div class="uc__bar" aria-hidden="true">
      <span class="uc__btns"><i></i><i></i><i></i></span>
      <span class="uc__wtitle">{{ section.settings.window_title }}</span>
    </div>
    <div class="uc__nav" aria-hidden="true">
      <span class="uc__navbtn">&#9664; Back</span><span class="uc__navbtn">Fwd &#9654;</span><span class="uc__navbtn">Reload</span>
      <span class="uc__addr">http://www.{{ shop.domain | default: 'example.com' }}/~home/index.htm</span>
    </div>
    <div class="uc__page">
      <div class="uc__banner"><span class="uc__beacon" aria-hidden="true"></span><p>{{ section.settings.banner }}</p><span class="uc__beacon" aria-hidden="true"></span></div>
      <img class="uc__logo" src="{{ 'logo-90s.svg' | asset_url }}" alt="" width="300" height="177">
      <h1 class="uc__title" id="UcTitle-{{ section.id }}">{{ section.settings.heading | default: brand }}</h1>
      <div class="uc__marquee" aria-hidden="true"><span>{{ section.settings.marquee }}</span><span>{{ section.settings.marquee }}</span></div>
      {%- if shop.password_message != blank -%}<p class="uc__msg">{{ shop.password_message }}</p>{%- else -%}<p class="uc__msg">{{ section.settings.message }}</p>{%- endif -%}
      <hr class="uc__hr" aria-hidden="true">

      <div class="uc__guest">
        <h2 class="uc__h2">{{ section.settings.guestbook_heading }}</h2>
        <p class="uc__small">{{ section.settings.guestbook_text }}</p>
        {%- form 'customer', id: 'GuestbookForm', class: 'uc__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,password-page">
          {%- if form.posted_successfully? -%}
            <p class="uc__ok" role="status">{{ section.settings.guestbook_thanks }}</p>
          {%- else -%}
            <label class="uc__lbl" for="GuestEmail">{{ 'newsletter.label' | t }}</label>
            <input class="uc__in" id="GuestEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="you@example.com"{% if form.errors %} aria-invalid="true" aria-describedby="GuestErr"{% endif %}>
            <button class="uc__btn" type="submit">{{ section.settings.guestbook_button }}</button>
            {%- if form.errors -%}<p class="uc__err" id="GuestErr">{{ 'newsletter.error' | t }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="uc__counter" aria-hidden="true"><span>{{ section.settings.counter_label }}</span><b>{{ section.settings.counter }}</b></div>
      <ul class="uc__badges" role="list" aria-hidden="true">
        <li>Best viewed at 800 &times; 600</li><li>Made with Notepad</li><li>Y2K ready</li><li>Hand-coded HTML</li>
      </ul>

      <details class="uc__door">
        <summary>{{ 'general.password_page.login_form_heading' | t }}</summary>
        {%- form 'storefront_password', class: 'uc__form uc__form--pw' -%}
          <label class="uc__lbl" for="StorePassword">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input class="uc__in" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"{% if form.errors %} aria-invalid="true"{% endif %}>
          <button class="uc__btn" type="submit">{{ 'general.password_page.login_form_submit' | t }}</button>
          {%- if form.errors -%}<p class="uc__err" role="alert">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
        {%- endform -%}
        <p class="uc__small">{{ 'general.password_page.admin_link_html' | t }}</p>
      </details>
      <p class="uc__foot">&copy; {{ 'now' | date: '%Y' }} {{ brand }} &middot; {{ powered_by_link }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Under construction",
  "class": "sct-uc",
  "settings": [
    { "type": "text", "id": "window_title", "label": "Window title", "default": "My Homepage - WebSurfer 2.0" },
    { "type": "text", "id": "banner", "label": "Banner", "default": "Under construction" },
    { "type": "text", "id": "heading", "label": "Heading (blank = store name)" },
    { "type": "text", "id": "marquee", "label": "Scrolling text", "default": "★ Welcome to my homepage! ★ 48 crosswords about the 1990s are on the way ★ Sign the guestbook! ★" },
    { "type": "textarea", "id": "message", "label": "Message (used when the store has none)", "default": "The shop is getting its last coat of paint. Sign the guestbook and we'll email you the day the doors open." },
    { "type": "text", "id": "guestbook_heading", "label": "Guestbook heading", "default": "Sign my guestbook!" },
    { "type": "text", "id": "guestbook_text", "label": "Guestbook text", "default": "Leave your email. One message when we open, nothing else." },
    { "type": "text", "id": "guestbook_button", "label": "Guestbook button", "default": "Sign it" },
    { "type": "text", "id": "guestbook_thanks", "label": "Guestbook thanks", "default": "Thanks for signing! See you on opening day." },
    { "type": "text", "id": "counter_label", "label": "Counter label", "default": "You are visitor no." },
    { "type": "text", "id": "counter", "label": "Counter digits", "default": "001990" }
  ]
}
{% endschema %}
