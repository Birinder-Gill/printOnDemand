{%- comment -%}
  Contact page: a pink "While You Were Out" message slip, torn off a pad and pinned to Memphis wallpaper, is the
  contact form (the topic is the row of check boxes). Next to it on a shelf, an answering machine with a red message
  counter and a microcassette; Play runs the tape and lights up the greeting (the page's own text) word by word.
{%- endcomment -%}
{{ 'pg-contact.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pg-contact.js' | asset_url }}" defer></script>
{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign topics = section.settings.topics | newline_to_br | split: '<br />'
-%}
<section class="ct" aria-labelledby="CtTitle-{{ section.id }}">
  <div class="ct__in">
    <header class="ct__head">
      <p class="ct__kicker">{{ section.settings.kicker }}</p>
      <h1 class="ct__title" id="CtTitle-{{ section.id }}">{{ heading }}</h1>
    </header>

    <div class="ct__grid">
      <div class="slip-wrap">
        <span class="slip__pin" aria-hidden="true"></span>
        <div class="slip">
          {%- form 'contact', id: 'ContactForm', class: 'slip__form' -%}
            <p class="slip__top" aria-hidden="true">{{ section.settings.pad_top }}</p>
            <h2 class="slip__title">{{ section.settings.slip_title }}</h2>

            {%- if form.posted_successfully? -%}
              <div class="slip__done" role="status" tabindex="-1" id="ContactSuccess">
                <span class="slip__stamp">{{ section.settings.stamp }}</span>
                <p>{{ 'contact.success' | t }}</p>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="slip__err" role="alert" id="ContactErrors">
                  <p><strong>{{ 'contact.error' | t }}</strong></p>
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <div class="slip__row slip__row--to" aria-hidden="true">
                <span class="slip__lbl">To</span><span class="slip__line slip__line--fixed">{{ section.settings.to_name }}</span>
              </div>
              <div class="slip__row slip__row--date" aria-hidden="true">
                <span class="slip__lbl">Date</span><span class="slip__line slip__line--fixed" data-ct-date>&nbsp;</span>
                <span class="slip__lbl">Time</span><span class="slip__line slip__line--fixed" data-ct-time>&nbsp;</span>
              </div>

              <p class="slip__while" aria-hidden="true">{{ section.settings.while_line }}</p>

              <div class="slip__row">
                <label class="slip__lbl" for="ContactName">{{ section.settings.label_name }}</label>
                <input class="slip__line slip__input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
              </div>
              <div class="slip__row">
                <label class="slip__lbl" for="ContactEmail">{{ section.settings.label_email }} <span class="slip__req" aria-hidden="true">*</span></label>
                <input class="slip__line slip__input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="ContactErrors"{% endif %}>
              </div>
              <div class="slip__row">
                <label class="slip__lbl" for="ContactPhone">{{ section.settings.label_phone }}</label>
                <input class="slip__line slip__input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
              </div>

              <fieldset class="slip__boxes">
                <legend class="slip__legend">{{ section.settings.topics_label }}</legend>
                {%- for t in topics -%}
                  {%- assign tt = t | strip -%}
                  {%- if tt != blank -%}
                    <label class="slip__box">
                      <input type="radio" name="contact[topic]" value="{{ tt | escape }}"{% if forloop.first %} checked{% endif %}>
                      <span class="slip__check" aria-hidden="true"></span>
                      <span class="slip__boxtxt">{{ tt }}</span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </fieldset>

              <div class="slip__msg">
                <label class="slip__lbl" for="ContactBody">{{ section.settings.label_message }} <span class="slip__req" aria-hidden="true">*</span></label>
                <textarea class="slip__area" id="ContactBody" name="contact[body]" rows="6" required aria-required="true">{{ form.body }}</textarea>
              </div>

              <div class="slip__foot">
                <p class="slip__by" aria-hidden="true"><span class="slip__lbl">Signed</span><span class="slip__line slip__line--fixed slip__sig" data-ct-sig>&nbsp;</span></p>
                <button class="btn" type="submit">{{ section.settings.button_label }}{%- render 'icon', name: 'envelope-simple' -%}</button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
        <div class="slip__under" aria-hidden="true"></div>
      </div>

      <div class="ct__side">
        <div class="am" data-am>
          <div class="am__top">
            <div class="am__counter" aria-hidden="true"><span class="am__led" data-am-led>00</span><span class="am__cap">Messages</span></div>
            <div class="am__tape" aria-hidden="true">
              <span class="am__reel"></span><span class="am__reel"></span>
              <span class="am__tapelbl">{{ section.settings.tape_label }}</span>
            </div>
            <div class="am__grille" aria-hidden="true"></div>
          </div>
          <div class="am__keys">
            <button class="am__key am__key--play" type="button" data-am-play aria-pressed="false">
              <span class="am__glyph" aria-hidden="true">&#9654;</span><span>{{ section.settings.play_label }}</span>
            </button>
            <span class="am__key" aria-hidden="true"><span class="am__glyph">&#9664;&#9664;</span><span>Rew</span></span>
            <span class="am__key" aria-hidden="true"><span class="am__glyph">&#9654;&#9654;</span><span>FF</span></span>
            <span class="am__key am__key--red" aria-hidden="true"><span class="am__glyph">&#9679;</span><span>Erase</span></span>
          </div>
          <p class="am__brand" aria-hidden="true"><span>{{ section.settings.machine_name }}</span> {{ section.settings.machine_model }}</p>
        </div>

        <div class="og">
          <p class="og__k">{{ section.settings.greeting_label }}</p>
          <div class="og__text rte" data-am-text>
            {%- if page.content != blank -%}{{ page.content }}{%- else -%}{{ section.settings.greeting }}{%- endif -%}
          </div>
        </div>

        {%- if section.settings.other_text != blank -%}
          <div class="ct__other rte">{{ section.settings.other_text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
  <div class="ct__shelf" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Message slip (contact)",
  "class": "sct-contact",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading (blank = page title)", "default": "Leave a message" },
    { "type": "header", "content": "Message slip" },
    { "type": "text", "id": "pad_top", "label": "Small line at the top", "default": "Important message" },
    { "type": "text", "id": "slip_title", "label": "Slip title", "default": "While you were out" },
    { "type": "text", "id": "to_name", "label": "To", "default": "The 90s America Crossword team" },
    { "type": "text", "id": "while_line", "label": "Line above the fields", "default": "Somebody called. Fill in the rest." },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "label_phone", "label": "Phone label", "default": "Phone" },
    { "type": "text", "id": "topics_label", "label": "Topics label", "default": "Regarding" },
    { "type": "textarea", "id": "topics", "label": "Topics (one per line)", "default": "My order\nThe book\nGifts and bulk orders\nJust saying hi" },
    { "type": "text", "id": "label_message", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Leave message" },
    { "type": "text", "id": "stamp", "label": "Stamp after sending", "default": "Message taken" },
    { "type": "header", "content": "Answering machine" },
    { "type": "text", "id": "machine_name", "label": "Name plate", "default": "Callback" },
    { "type": "text", "id": "machine_model", "label": "Model", "default": "TAM-90" },
    { "type": "text", "id": "tape_label", "label": "Tape label", "default": "Greeting" },
    { "type": "text", "id": "play_label", "label": "Play button label", "default": "Play greeting" },
    { "type": "text", "id": "greeting_label", "label": "Greeting label", "default": "Outgoing message" },
    { "type": "richtext", "id": "greeting", "label": "Greeting (used when the page has no text)", "default": "<p>Hi, you've reached us. Leave a message after the beep.</p>" },
    { "type": "richtext", "id": "other_text", "label": "Other ways to reach us" }
  ]
}
{% endschema %}
