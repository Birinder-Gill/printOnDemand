{%- comment -%}
  FAQ page header: a school hallway. A row of painted lockers (vents, number plates, lift handles, one combination
  lock, a few stickers) on a waxed tile floor, with a hand-painted butcher-paper banner taped across them carrying the
  page heading, one tempera letter at a time.
{%- endcomment -%}
{{ 'pg-lockers.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign colors = 'magenta,grape,teal,tangerine,sky' | split: ','
  assign stickers = section.settings.stickers | split: ','
-%}
<section class="hall" aria-labelledby="HallTitle-{{ section.id }}">
  <div class="hall__lockers" aria-hidden="true">
    {%- for i in (1..10) -%}
      {%- assign n = i | plus: 213 -%}
      {%- assign si = i | minus: 1 -%}
      <div class="lk lk--{{ i | modulo: 5 }}">
        <span class="lk__vents"></span>
        <span class="lk__plate">{{ n }}</span>
        <span class="lk__handle"></span>
        {%- if i == 4 or i == 9 -%}<span class="lk__dial"></span>{%- endif -%}
        {%- assign st = stickers[si] | strip -%}
        {%- if st != blank -%}<img class="lk__st lk__st--{{ i | modulo: 3 }}" src="{{ 'st-' | append: st | append: '.svg' | asset_url }}" alt="" width="90" height="90" loading="lazy">{%- endif -%}
        <span class="lk__vents lk__vents--b"></span>
      </div>
    {%- endfor -%}
  </div>
  <div class="hall__floor" aria-hidden="true"></div>

  <div class="hall__banner">
    <span class="hall__tape hall__tape--l" aria-hidden="true"></span>
    <span class="hall__tape hall__tape--r" aria-hidden="true"></span>
    <p class="hall__kicker">{{ section.settings.kicker }}</p>
    <h1 class="hall__title" id="HallTitle-{{ section.id }}" aria-label="{{ heading | escape }}">
      {%- assign words = heading | split: ' ' -%}
      {%- assign k = 0 -%}
      {%- for w in words -%}
        <span class="hall__word" aria-hidden="true">
          {%- assign chars = w | split: '' -%}
          {%- for c in chars -%}
            {%- assign ci = k | modulo: 5 -%}
            {%- assign r = k | times: 7 | modulo: 9 | minus: 4 -%}
            <span class="hall__ch hall__ch--{{ colors[ci] }}" style="--r:{{ r }}deg">{{ c }}</span>
            {%- assign k = k | plus: 1 -%}
          {%- endfor -%}
        </span>
      {%- endfor -%}
    </h1>
    {%- if section.settings.sub != blank -%}<p class="hall__sub">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "School hallway header",
  "class": "sct-hall",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading (blank = page title)", "default": "Got questions?" },
    { "type": "text", "id": "sub", "label": "Line under the heading", "default": "Pass a note. Somebody already did." },
    { "type": "text", "id": "stickers", "label": "Stickers per locker (comma separated, blank to skip)", "default": "smiley,,alien,,,yinyang,,pizza,,skate" }
  ],
  "presets": [ { "name": "School hallway header" } ]
}
{% endschema %}
