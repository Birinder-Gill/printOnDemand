{%- comment -%} Announcement strip: a mono crawl on ink. Messages are blocks; each can link somewhere. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="qann" role="region" aria-label="{{ section.settings.label | escape }}" data-marquee>
  <div class="q-marquee qann__crawl" style="--q-marq: {{ section.settings.speed | times: section.blocks.size }}s">
    {%- for k in (1..2) -%}
      <ul class="q-marquee__track qann__list" role="list"{% if k == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li class="qann__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}"{% if k == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
            <span class="qann__sep" aria-hidden="true">✸</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
  {%- render 'qh-mtoggle', class: 'qann__toggle' -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement strip",
  "class": "sct-announce",
  "settings": [
    { "type": "text", "id": "label", "label": "Label for screen readers", "default": "Announcements" },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 4, "max": 20, "step": 1, "default": 9 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Loud books for quiet hours" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
