{%- comment -%} Page body: the page's content as rich text, with an optional side column of facts (blocks). {%- endcomment -%}
<section class="qpage q-sect qs-{{ section.settings.scheme }}">
  <div class="q-wrap q-pad qpage__grid{% if section.blocks.size == 0 %} qpage__grid--solo{% endif %}">
    <div class="q-rte qpage__body">{{ page.content }}</div>
    {%- if section.blocks.size > 0 -%}
      <aside class="qpage__side">
        {%- for block in section.blocks -%}
          <div class="qpage__card" {{ block.shopify_attributes }}>
            <p class="q-label qpage__card-h">{{ block.settings.heading }}</p>
            <div class="qpage__card-b">{{ block.settings.text }}</div>
            {%- if block.settings.link_label != blank -%}<a class="q-arrowlink" href="{{ block.settings.link }}">{{ block.settings.link_label }}{% render 'qh-arrow', class: '' %}</a>{%- endif -%}
          </div>
        {%- endfor -%}
      </aside>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "class": "sct-page",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color", "default": "white", "options": [
      { "value": "white", "label": "White" }, { "value": "paper", "label": "Paper" } ] }
  ],
  "blocks": [
    { "type": "card", "name": "Side card", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a short fact here.</p>" },
      { "type": "text", "id": "link_label", "label": "Link label" },
      { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Page content" }]
}
{% endschema %}
