{%- comment -%}
  Password page: the press is setting type. Logo, a huge "Opening soon", the store message, the mailing list,
  and the owner's password form behind a ruled toggle.
{%- endcomment -%}
{%- assign brand = settings.brand_name | default: shop.name -%}
<section class="qpw" aria-labelledby="PwTitle">
  <div class="qpw__bar">
    <span class="qhd__logo">{%- render 'qh-logo', word: true -%}<span class="visually-hidden">{{ brand }}</span></span>
    <span class="qhd__fill"></span>
    <details class="qpw__owner">
      <summary class="qhd__cell">{{ 'password.owner' | t }}</summary>
      <div class="qpw__login">
        {%- form 'storefront_password', class: 'qpw__form' -%}
          <label class="q-label" for="PwInput">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <div class="q-inline">
            <input class="q-input" id="PwInput" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
            <button class="q-btn" type="submit">{{ 'general.password_page.login_form_submit' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="q-msg q-msg--err" role="alert">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
        {%- endform -%}
        <p class="q-label qpw__admin">{{ 'general.password_page.admin_link_html' | t }}</p>
      </div>
    </details>
  </div>
  <div class="qpw__hero qs-yellow">
    <div class="q-wrap qpw__in">
      <p class="q-tag">{{ brand }}</p>
      <h1 class="qpw__t" id="PwTitle">{% render 'qh-hl', text: section.settings.heading %}</h1>
      {%- if shop.password_message != blank -%}<p class="q-lede">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'customer', class: 'qpw__sign' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="q-msg" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <label class="q-label" for="PwEmail">{{ section.settings.signup_label }}</label>
          <div class="q-inline">
            <input class="q-input" id="PwEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.placeholder' | t }}">
            <button class="q-btn q-btn--ink" type="submit">{{ 'newsletter.submit' | t }}{% render 'qh-arrow' %}</button>
          </div>
          {%- if form.errors -%}<p class="q-msg q-msg--err" role="alert">{{ 'newsletter.error' | t }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
  <div class="qmq qs-ink" aria-hidden="true">
    <div class="q-marquee" style="--q-marq: 30s">
      {%- for k in (1..2) -%}<div class="q-marquee__track qmq__track">{%- for i in (1..4) -%}<span class="qmq__w">{{ section.settings.marquee }}</span><span class="qmq__w qmq__w--o">✸</span>{%- endfor -%}</div>{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Opening soon",
  "class": "sct-password",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Setting [type].\nOpening soon." },
    { "type": "text", "id": "signup_label", "label": "Signup label", "default": "Get one email when the doors open" },
    { "type": "text", "id": "marquee", "label": "Marquee text", "default": "Loud books for quiet hours" }
  ]
}
{% endschema %}
