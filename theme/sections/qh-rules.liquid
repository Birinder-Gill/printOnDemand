{%- comment -%}
  House rules: numbered cells in a ruled grid. One cell can be inverted. Hover lights a cell yellow.
{%- endcomment -%}
{{ 'qh-rules.css' | asset_url | stylesheet_tag }}
<section class="qrules qs-{{ section.settings.scheme }} q-sect" aria-labelledby="Rules-{{ section.id }}">
  <div class="q-wrap q-pad">
    <div class="q-head">
      {%- if section.settings.index != blank -%}<span class="q-head__idx q-label">{{ section.settings.index }}</span>{%- endif -%}
      <h2 class="q-h2" id="Rules-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.aside != blank -%}<p class="q-head__aside">{{ section.settings.aside }}</p>{%- endif -%}
    </div>
    <ol class="qrules__grid" role="list" style="--cols: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <li class="qrules__cell q-rise{% if block.settings.invert %} qrules__cell--inv{% endif %}" style="--d: {{ forloop.index0 | times: 70 }}ms" {{ block.shopify_attributes }}>
          <span class="qrules__n" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="qrules__t">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="qrules__p">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "House rules",
  "class": "sct-rules",
  "settings": [
    { "type": "text", "id": "index", "label": "Index label", "default": "[03]" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "House rules" },
    { "type": "textarea", "id": "aside", "label": "Side note", "default": "How every Quiet Hour Press book gets made." },
    { "type": "select", "id": "scheme", "label": "Color", "default": "paper", "options": [
      { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "yellow", "label": "Yellow" }, { "value": "ink", "label": "Ink" } ] }
  ],
  "blocks": [
    { "type": "rule", "name": "Rule", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "One idea per book" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Each book picks one subject and goes all the way with it." },
      { "type": "checkbox", "id": "invert", "label": "Inverted (ink)", "default": false } ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "House rules", "blocks": [{ "type": "rule" }, { "type": "rule" }, { "type": "rule" }, { "type": "rule" }] }]
}
{% endschema %}
