{%- comment -%}
  Hero, "the cover, unfolded": the book cover's crossword mosaic spreads across the screen. CROSSWORD runs across
  and AMERICA runs down in paper tiles that type themselves in once on load; the holographic 90s sticker slaps on and
  catches the light as the pointer moves; the gold seal; the hardcover on its own stage; the clue panel holds the buy
  button. Layout is a grid of square cells (16 wide on desktop, 12 on tablet, 9 on phones) that lines up exactly
  with the mosaic artwork behind it.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: product | default: settings.hero_product
  assign title_tag = section.settings.title_tag | default: 'h1'
  assign variant = product.selected_or_first_available_variant
  assign across = 'CROSSWORD' | split: ''
  assign down = 'AMERICA' | split: ''
  assign brand = settings.brand_name | default: shop.name
-%}
{{ 's-hero-grid.css' | asset_url | stylesheet_tag }}

<section class="hx" data-hero aria-labelledby="HeroTitle-{{ section.id }}" style="--grid-art: url('{{ 'hero-grid.svg' | asset_url }}')">
  <{{ title_tag }} class="visually-hidden" id="HeroTitle-{{ section.id }}">{{ section.settings.title | default: brand }}</{{ title_tag }}>
  <div class="hx__grid">
    {%- comment -%} frame squares: plain black cells around the entries, as in a real grid {%- endcomment -%}
    {%- for k in (1..14) -%}<span class="hx__ink hx__ink--{{ k }}" aria-hidden="true"></span>{%- endfor -%}

    <div class="hx__word hx__word--across" aria-hidden="true">
      {%- for ch in across -%}
        <span class="hx__tile{% if forloop.index == 8 %} hx__tile--cross{% endif %}" style="--i: {{ forloop.index0 }}">{% if forloop.first %}<span class="hx__num">2</span>{% endif %}<span class="hx__ch">{{ ch }}</span></span>
      {%- endfor -%}
    </div>
    <div class="hx__word hx__word--down" aria-hidden="true">
      {%- for ch in down -%}
        {%- assign d = forloop.index0 | plus: 9 -%}
        <span class="hx__tile{% if forloop.index == 4 %} hx__tile--shared{% endif %}" style="--i: {{ d }}">{% if forloop.first %}<span class="hx__num">1</span>{% endif %}<span class="hx__ch">{{ ch }}</span></span>
      {%- endfor -%}
    </div>

    <p class="hx__tag" aria-hidden="true"><span>{{ section.settings.tagline }}</span></p>

    <div class="hx__sticker" aria-hidden="true" data-holo>
      <img src="{{ 'logo-90s.svg' | asset_url }}" alt="" width="1040" height="612">
      <span class="hx__sheen"></span>
    </div>

    <div class="hx__stage">
      <div class="hx__spot" aria-hidden="true"></div>
      {%- if section.settings.book_image != blank -%}
        {{ section.settings.book_image | image_url: width: 1300 | image_tag:
          class: 'hx__book', alt: section.settings.book_alt, loading: 'eager', fetchpriority: 'high',
          widths: '420, 560, 720, 900, 1100, 1300', sizes: '(min-width: 1100px) 36vw, (min-width: 750px) 34vw, 70vw' }}
      {%- endif -%}
      {%- if section.settings.stage_note != blank -%}
        <p class="hx__note"><span>{{ section.settings.stage_note }}</span></p>
      {%- endif -%}
    </div>

    <div class="hx__clue">
      <p class="hx__clue-num"><span>{{ section.settings.clue_label }}</span></p>
      <p class="hx__lede">{{ section.settings.lede }}</p>
      {%- if product != blank -%}
        {%- form 'product', product, class: 'hx__form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <div class="hx__actions">
            <button class="btn btn--lg hx__buy" type="submit" name="add"{% unless variant.available %} disabled{% endunless %}>
              {%- if variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
              <span class="btn__price">{{ variant.price | money_without_trailing_zeros }}</span>
            </button>
            {%- if section.settings.link_label != blank -%}
              {%- assign more_url = product.url | append: '#look-inside' -%}
              {%- if section.settings.link_url != blank -%}{%- assign more_url = section.settings.link_url -%}{%- endif -%}
              <a class="hx__more" href="{{ more_url }}">{{ section.settings.link_label }}</a>
            {%- endif -%}
          </div>
          <p class="hx__err" data-form-error hidden role="alert"></p>
        {%- endform -%}
      {%- endif -%}
      <p class="hx__fine">{{ section.settings.fine_print }}</p>
    </div>
  </div>
</section>

<script src="{{ 's-hero-grid.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero: the cover, unfolded",
  "class": "sct-hero",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Book",
      "info": "Defaults to the featured book in theme settings."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page heading (read by search engines and screen readers)",
      "default": "90s America Crossword: The Throwback Puzzle Book, Gift Edition"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brushed tagline",
      "default": "the throwback puzzle book"
    },
    {
      "type": "image_picker",
      "id": "book_image",
      "label": "Book image (transparent PNG)"
    },
    {
      "type": "text",
      "id": "book_alt",
      "label": "Book image description",
      "default": "The 90s America Crossword gift edition hardcover, standing"
    },
    {
      "type": "text",
      "id": "stage_note",
      "label": "Note on the book stage",
      "default": "Gift Edition hardcover"
    },
    {
      "type": "text",
      "id": "clue_label",
      "label": "Clue label",
      "default": "1 Across"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Clue text",
      "default": "Forty-eight crosswords about the 1990s, in a hardcover gift edition where every page is designed as a different piece of the decade."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "default": "Look inside"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Second link"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Small print",
      "default": "80 full-color pages, 8.25 × 11 inches, answer key in the back."
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Hidden title level",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "Main title (h1)"
        },
        {
          "value": "h2",
          "label": "Section title (h2)"
        },
        {
          "value": "p",
          "label": "Not a heading"
        }
      ],
      "info": "On a product page that has its own h1 below, use \"Not a heading\"."
    }
  ],
  "presets": [
    {
      "name": "Hero: the cover, unfolded"
    }
  ]
}
{% endschema %}
