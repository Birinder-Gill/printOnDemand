{%- comment -%}
  Header, styled as the hang tab of a blister-carded toy: a glossy printed card with a euro hang hole cut
  through it (content scrolls past behind the hole), the holographic 90s sticker as the logo, crossword tiles
  for the wordmark and a price-gun tag for the cart. On phones the menu opens as a holographic sticker sheet.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign menu = section.settings.menu
  assign word_top = section.settings.word_top | default: 'America'
  assign word_tiles = section.settings.word_tiles | default: 'Crossword' | upcase
-%}
<header class="hdr" data-header>
  <div class="hdr__card">
    <div class="hdr__inner">
      <button class="hdr__menu-btn" type="button" aria-controls="MenuSheet" aria-expanded="false" data-menu-open>
        {%- render 'icon', name: 'list', class: 'hdr__menu-icon' -%}
        <span>{{ 'general.menu' | t }}</span>
      </button>

      <a class="hdr__logo" href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>
        <img class="hdr__logo-90s" src="{{ 'logo-90s.svg' | asset_url }}" alt="" width="128" height="72">
        <span class="hdr__logo-word" aria-hidden="true">
          <span class="hdr__logo-top">{{ word_top }}</span>
          <span class="hdr__logo-tiles">
            {%- assign chars = word_tiles | split: '' -%}
            {%- for ch in chars -%}<span class="hdr__tile">{{ ch }}</span>{%- endfor -%}
          </span>
        </span>
        <span class="visually-hidden">{{ brand }}</span>
      </a>

      <span class="hdr__hole" aria-hidden="true"></span>

      {%- if menu != blank -%}
        {%- assign half = menu.links.size | plus: 1 | divided_by: 2 -%}
        {%- assign half_next = half | plus: 1 -%}
        <nav class="hdr__nav" aria-label="Main">
          <ul class="hdr__links" role="list">
            {%- for link in menu.links -%}
              <li class="hdr__li{% if forloop.index > half %} is-right{% endif %}{% if forloop.index == half_next %} is-first-right{% endif %}">
                <a class="hdr__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <a class="hdr__cart" href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'general.cart' | t }}, {{ 'cart.item_count' | t: count: cart.item_count }}">
        <span class="hdr__cart-tag" aria-hidden="true">
          <span class="hdr__cart-hole"></span>
          <span class="hdr__cart-word">{{ 'general.cart' | t }}</span>
          <span class="hdr__cart-count" data-cart-count>{{ cart.item_count }}</span>
        </span>
      </a>
    </div>
  </div>
</header>

<div class="sheet" id="MenuSheet" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}" hidden data-menu-sheet>
  <div class="sheet__paper">
    <div class="sheet__head">
      <p class="sheet__label"><span>{{ section.settings.sheet_label }}</span><span>{{ section.settings.sheet_number }}</span></p>
      <button class="sheet__close" type="button" data-menu-close>
        {%- render 'icon', name: 'x' -%}<span class="visually-hidden">{{ 'general.close_menu' | t }}</span>
      </button>
    </div>
    {%- if menu != blank -%}
      <nav aria-label="Main">
        <ul class="sheet__links" role="list">
          {%- for link in menu.links -%}
            <li class="sheet__item" style="--i: {{ forloop.index0 }}">
              <a class="sheet__sticker" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    <div class="sheet__extras" aria-hidden="true">
      <img src="{{ 'st-cassette.svg' | asset_url }}" alt="" width="80" height="60" loading="lazy" class="sheet__x sheet__x--1">
      <img src="{{ 'st-smiley.svg' | asset_url }}" alt="" width="60" height="60" loading="lazy" class="sheet__x sheet__x--2">
      <img src="{{ 'st-pager.svg' | asset_url }}" alt="" width="70" height="60" loading="lazy" class="sheet__x sheet__x--3">
      <span class="sheet__x sheet__x--cut"></span>
    </div>
    <a class="btn btn--block sheet__cta" href="{{ routes.cart_url }}" data-cart-open>{{ 'cart.title' | t }} <span class="btn__price" data-cart-count>{{ cart.item_count }}</span></a>
  </div>
</div>

{% schema %}
{
  "name": "Hang-tab header",
  "class": "sct-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "word_top", "label": "Wordmark, small line", "default": "America" },
    { "type": "text", "id": "word_tiles", "label": "Wordmark, tiles", "default": "Crossword", "info": "Each letter gets its own crossword tile. Keep it short." },
    { "type": "text", "id": "sheet_label", "label": "Phone menu: sheet label", "default": "Prismatic stickers" },
    { "type": "text", "id": "sheet_number", "label": "Phone menu: sheet number", "default": "Sheet No. 1" }
  ]
}
{% endschema %}
