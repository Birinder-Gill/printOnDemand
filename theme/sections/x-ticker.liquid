{%- comment -%}
  Announcement ticker, styled as a 1992 newscast crawl: a red bug, a navy crawl bar with a chrome edge,
  and the time-and-temperature box. The crawl pauses on hover and stays still for reduced motion.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="tkr" role="region" aria-label="{{ section.settings.label | escape }}" style="--tkr-speed: {{ section.blocks.size | times: section.settings.speed }}s">
  <p class="tkr__bug"><span class="tkr__bug-dot" aria-hidden="true"></span>{{ section.settings.bug }}</p>
  <div class="tkr__window" data-ticker>
    {%- for copy in (1..2) -%}
      <ul class="tkr__list" role="list"{% if copy == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li class="tkr__item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}"{% if copy == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
  {%- if section.settings.show_clock -%}
    <p class="tkr__clock" aria-hidden="true"><span>{{ section.settings.time }}</span><span class="tkr__temp">{{ section.settings.temp }}</span></p>
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Newscast ticker",
  "class": "sct-ticker",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "bug", "label": "Bug label", "default": "New" },
    { "type": "text", "id": "label", "label": "Accessible name", "default": "Announcements" },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 4, "max": 16, "step": 1, "default": 9 },
    { "type": "checkbox", "id": "show_clock", "label": "Show time and temperature", "default": true },
    { "type": "text", "id": "time", "label": "Time", "default": "7:05" },
    { "type": "text", "id": "temp", "label": "Temperature", "default": "72°" }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "The Gift Edition hardcover is here" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Newscast ticker", "blocks": [ { "type": "message" } ] } ]
}
{% endschema %}
