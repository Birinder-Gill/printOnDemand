{%- comment -%}
  Product card for the catalog, collections, search and "more from the press".
  {% render 'qh-card', product: p, index: forloop.index0, sizes: '(min-width: 990px) 33vw, 100vw', class: '' %}
  Reads optional product metafields: custom.catalog_number ("001"), custom.tagline, custom.cutout (image with a
  transparent background, shown on a flat color panel instead of the first product photo).
{%- endcomment -%}
{%- liquid
  assign p = product
  assign colors = 'yellow,red,blue' | split: ','
  assign ci = index | default: 0 | modulo: 3
  assign tone = color | default: colors[ci]
  assign num = p.metafields.custom.catalog_number.value
  assign cut = p.metafields.custom.cutout.value
  assign line = p.metafields.custom.tagline.value
  assign parts = p.title | split: ' — '
  assign name = parts | first
  if line == blank
    if parts.size > 1
      assign line = parts | last
    else
      assign line = p.description | strip_html | truncatewords: 14
    endif
  endif
  assign img = cut | default: p.featured_media
-%}
<article class="q-card q-card--{{ tone }} {{ class }}">
  <div class="q-card__top q-label">
    <span>{% if num != blank %}No. {{ num }}{% else %}{{ p.type | default: 'Book' }}{% endif %}</span>
    {%- if num != blank and p.type != blank -%}<span>{{ p.type }}</span>{%- endif -%}
  </div>
  <div class="q-card__media{% if cut == blank %} q-card__media--photo{% endif %}">
    {%- if img -%}
      {{ img | image_url: width: 1000 | image_tag: widths: '360,540,720,1000', sizes: sizes, alt: '', loading: 'lazy' }}
    {%- endif -%}
    {%- unless p.available -%}<span class="q-tag q-tag--fill q-card__sold">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
  </div>
  <div class="q-card__body">
    <h3 class="q-card__title"><a href="{{ p.url }}">{{ name }}</a></h3>
    {%- if line != blank -%}<p class="q-card__line">{{ line }}</p>{%- endif -%}
    {%- if class contains 'q-card--wide' -%}
      {%- assign excerpt = p.description | strip_html | truncatewords: 46 -%}
      {%- if excerpt != blank -%}<p class="q-card__excerpt">{{ excerpt }}</p>{%- endif -%}
      {%- if p.tags.size > 0 -%}
        <ul class="q-card__tags" role="list">{%- for t in p.tags limit: 5 -%}<li class="q-tag">{{ t }}</li>{%- endfor -%}</ul>
      {%- endif -%}
    {%- endif -%}
    <div class="q-card__foot">
      <span class="q-card__price">{% if p.price_varies %}From {% endif %}{{ p.price | money_without_trailing_zeros }}</span>
      <span class="q-card__go" aria-hidden="true">{{ 'products.view' | t }} {% render 'qh-arrow', class: '' %}</span>
    </div>
  </div>
</article>
