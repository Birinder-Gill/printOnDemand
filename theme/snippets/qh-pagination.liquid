{%- comment -%} Ruled pagination cells. {% render 'qh-pagination', paginate: paginate %} {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="q-pages" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">&larr;</a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>
      {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">&rarr;</a>{%- endif -%}
  </nav>
{%- endif -%}
