{%- comment -%}
  Ransom-note lettering: every letter cut from a different magazine. Visual only; pass the real text as an
  accessible label on the parent heading. {% render 'ransom', text: 'Hello' %}
{%- endcomment -%}
{%- assign words = text | split: ' ' -%}
{%- assign k = 0 -%}
{%- for w in words -%}
  <span class="rn__w" aria-hidden="true">
    {%- assign chars = w | split: '' -%}
    {%- for c in chars -%}
      {%- assign v = k | times: 7 | plus: forloop.index | modulo: 6 -%}
      {%- assign r = k | times: 5 | modulo: 9 | minus: 4 -%}
      <span class="rn rn--{{ v }}" style="--r:{{ r }}deg">{{ c }}</span>
      {%- assign k = k | plus: 1 -%}
    {%- endfor -%}
  </span>
{%- endfor -%}
