    "faq": {
      "type": "s-notes",
      "settings": {},
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "How hard are the puzzles?",
            "answer": "<p>Friendly, not fiendish. Every answer is a single word of 5 to 12 letters, and the tougher ones come with a hint printed upside down at the foot of the page.</p>",
            "sign": "— K."
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "Do I need to have grown up in America?",
            "answer": "<p>It helps. The clues are about American TV, movies, music, toys, food, sports and slang from 1990 to 1999.</p>",
            "sign": ""
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "Is there an answer key?",
            "answer": "<p>Yes. Every solved grid is in the back, in a section called Cheat Codes.</p>",
            "sign": "— J."
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "Can I write in it?",
            "answer": "<p>Please do. There's one puzzle per page, with room around the grid.</p>",
            "sign": ""
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "question": "How big is it?",
            "answer": "<p>8.25 × 11 inches, hardcover, with 80 full-color pages.</p>",
            "sign": ""
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "question": "Is it a good gift?",
            "answer": "<p>That's the idea. There's an autograph page up front, so you can sign it before you give it.</p>",
            "sign": "H.A.G.S.!"
          }
        },
        "q7": {
          "type": "faq",
          "settings": {
            "question": "Do I have to go in order?",
            "answer": "<p>No. Start anywhere. Every puzzle stands on its own.</p>",
            "sign": ""
          }
        },
        "q8": {
          "type": "faq",
          "settings": {
            "question": "What makes it different from other crossword books?",
            "answer": "<p>Every page has its own design: a cereal box, a tape case, a mall directory, a newscast. No two pages look alike.</p>",
            "sign": ""
          }
        },
        "q9": {
          "type": "faq",
          "settings": {
            "question": "How does shipping work?",
            "answer": "<p>Shipping options and costs are shown at checkout, before you pay.</p>",
            "sign": ""
          }
        }
      },
